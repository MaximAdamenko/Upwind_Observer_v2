# Copy this file to .env and fill in your values

# API auth key — sent by Google Apps Script in the Authorization header
API_KEY=your-secret-key-here

# Anthropic Claude API key (https://console.anthropic.com/)
CLAUDE_API_KEY=sk-ant-...

# Claude model to use for email classification
CLAUDE_MODEL=claude-sonnet-4-6

# VirusTotal API key (https://www.virustotal.com/gui/join-us)
VIRUS_TOTAL_KEY=your-vt-key-here

# SQLite (default) or PostgreSQL for production
DATABASE_URL=sqlite:///./upwind.db
# DATABASE_URL=postgresql://user:password@localhost:5432/upwind
